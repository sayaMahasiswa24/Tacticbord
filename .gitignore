# ==============================================================================
# Laravel & Application Runtime Files
# ==============================================================================
/vendor
/storage/*.key
/storage/pail
/storage/inertia-devtools/*
!/storage/inertia-devtools/.gitignore
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
!/storage/logs/.gitkeep

# ==============================================================================
# Environment & Sensitive Files
# ==============================================================================
.env
.env.*
!.env.example
.env.backup
.env.production
auth.json
Homestead.json
Homestead.yaml

# ==============================================================================
# Node & Frontend Build Artifacts
# ==============================================================================
/node_modules
**/node_modules/
/public/build
/public/hot
/public/storage
dist
build

# ==============================================================================
# Local Database & SQLite WAL Files
# ==============================================================================
# database/database.sqlite is pre-seeded and bundled into Git for Vercel deployment
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
/database/*.sqlite-journal
/database/*.sqlite-wal
/database/*.sqlite-shm

# ==============================================================================
# Logs, Debugging & Test Artifacts
# ==============================================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.phpunit.result.cache
.phpunit.cache
.styleci.cache
.phpactor.json

# ==============================================================================
# Operating System & IDE Files
# ==============================================================================
.DS_Store
Thumbs.db
desktop.ini
/.fleet
/.idea
/.nova
/.vscode
/.zed

# ==============================================================================
# Local Scratch, Dummy, Agent & Legacy Archive Files
# ==============================================================================
/_legacy_archive/
/frontend dumy/
/.agents/
skills-lock.json
/takticboard-beta/
/tacticboard-beta/

